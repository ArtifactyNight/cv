---
import PortableText from "../../components/sanity/PortableText.astro";
import { getAdjacentPosts } from "../../lib/blog-nav";
import { excerptFromDescription } from "../../lib/excerpt";
import { getAllPosts, getPostBySlug } from "../../lib/sanity/posts";
import BlogPost from "../../layouts/BlogPost.astro";

export async function getStaticPaths() {
  const posts = await getAllPosts();

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      adjacent: getAdjacentPosts(posts, post.slug),
    },
  }));
}

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join("/") : slugParam;
const post = slug ? await getPostBySlug(slug) : null;

if (!post) {
  return Astro.redirect("/404");
}

const { adjacent } = Astro.props;
const description = excerptFromDescription(post.description, post.body);
const pubDate = new Date(post.pubDate);
const updatedDate = post.updatedDate ? new Date(post.updatedDate) : undefined;
---

<BlogPost
  title={post.title}
  description={description}
  slug={post.slug}
  pubDate={pubDate}
  updatedDate={updatedDate}
  adjacent={adjacent}
>
  {post.body && <PortableText value={post.body} />}
</BlogPost>
