---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getAdjacentPosts } from "../../lib/blog-nav";
import BlogPost from "../../layouts/BlogPost.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      adjacent: getAdjacentPosts(posts, post.id),
    },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  adjacent: ReturnType<typeof getAdjacentPosts>;
}

const { post, adjacent } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} slug={post.id} adjacent={adjacent}>
  <Content />
</BlogPost>
