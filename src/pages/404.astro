---
import HomeHeader from "../components/home/HomeHeader.astro";
import SiteFooter from "../components/home/SiteFooter.astro";
import Layout from "../layouts/Layout.astro";

Astro.response.status = 404;
Astro.response.statusText = "Not Found";
---

<Layout
  title="ไม่พบหน้า"
  description="หน้าที่คุณกำลังมองหาไม่มีอยู่บนไซต์นี้"
  noindex
>
  <HomeHeader />
  <section
    class="flex flex-col items-center py-16 text-center"
    aria-labelledby="not-found-heading"
  >
    <p class="font-sentient text-sm italic text-ink-muted">404</p>
    <h1
      id="not-found-heading"
      class="mt-2 text-balance font-sentient text-2xl font-medium italic leading-[1.15] text-ink"
    >
      Page Not Found
    </h1>
    <p class="mt-3 max-w-prose text-sm text-ink-muted">
      ลิงก์อาจหมดอายุ หรือพิมพ์ URL ไม่ถูกต้อง
    </p>
    <p class="mt-6">
      <a
        href="/"
        class="text-sm font-sentient text-accent no-underline hover:text-accent-deep hover:underline"
        >กลับหน้าหลัก</a
      >
    </p>
  </section>
  <SiteFooter />
</Layout>
