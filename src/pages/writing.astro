---
import { getAllPosts } from "../lib/sanity/posts";
import HomeHeader from "../components/home/HomeHeader.astro";
import SiteFooter from "../components/home/SiteFooter.astro";
import WritingList from "../components/home/WritingList.astro";
import Layout from "../layouts/Layout.astro";

const posts = await getAllPosts();
---

<Layout title="Writing">
  <HomeHeader current="writing" />
  <WritingList posts={posts} />
  <SiteFooter />
</Layout>
