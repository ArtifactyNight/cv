---
import { profile } from "../../data/profile";
import HomeActivityCalendar from "./ActivityCalendar";

const githubUsername = new URL(
  profile.social.find((link) => link.icon === "mdi:github-box")!.href,
).pathname.slice(1);
---

<section class="scroll-mt-8" aria-labelledby="activity-heading">
  <div class="overflow-x-auto text-ink-muted">
    <HomeActivityCalendar
      client:visible={{ rootMargin: "200px" }}
      username={githubUsername}
    >
      <div class="activity-calendar-placeholder" aria-hidden="true" slot="fallback">
      </div>
    </HomeActivityCalendar>
  </div>
</section>
