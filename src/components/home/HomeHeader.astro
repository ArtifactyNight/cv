---
import { profile } from "../../data/profile";
---

<header id="top" class="scroll-mt-8">
  <div class="flex items-center gap-2">
    <h1
      class="text-balance font-sentient text-2xl font-medium italic leading-[1.15] text-ink"
    >
      {profile.name}
    </h1>
    <a
      href="https://webring.wonderful.software/#/nightz.me"
      title="วงแหวนเว็บ"
      class="shrink-0 opacity-60 hover:opacity-100 hover:rotate-12 transition-transform duration-300"
    >
      <img
        alt="วงแหวนเว็บ"
        width="18"
        height="18"
        loading="lazy"
        decoding="async"
        src="https://webring.wonderful.software/webring.svg"
      />
    </a>
  </div>

  <blockquote class="mt-2 max-w-prose text-pretty">
    <p class="font-sentient text-sm italic leading-snug text-ink-muted">
      “{profile.quote.text}”
    </p>
    <footer class="mt-1 text-xs text-ink-muted/80">
      — <cite class="not-italic">{profile.quote.author}</cite>
    </footer>
  </blockquote>
</header>
