---
import { Image } from "astro:assets";
import me from "../../assets/me.jpeg";
import { profile } from "../../data/profile";
import HomeNavLink from "./HomeNavLink.astro";
// import ThemeToggle from "../ThemeToggle.astro";

interface Props {
  current?: "home" | "work" | "writing";
}

const { current = "home" } = Astro.props;

const navItems = [
  { nav: "home", href: "/", label: "หน้าหลัก" },
  { nav: "work", href: "/work", label: "ผลงาน" },
  { nav: "writing", href: "/writing", label: "บทความ" },
] as const;
---

<header id="top" class="scroll-mt-8 flex items-start justify-between gap-5">
  <div>
    <div class="mb-5">
      <div class="flex items-center gap-2">
        <h1
          class="text-balance font-sentient text-2xl font-medium italic leading-[1.15] text-ink"
        >
          {profile.name}
        </h1>
        <a
          href="https://webring.wonderful.software/#/nightz.me"
          title="วงแหวนเว็บ"
          class="shrink-0 opacity-60 hover:opacity-100 hover:rotate-12 transition-transform duration-300"
        >
          <img
            alt="วงแหวนเว็บ"
            width="18"
            height="18"
            src="https://webring.wonderful.software/webring.svg"
          />
        </a>
      </div>

      <blockquote class="mt-2 max-w-prose text-pretty">
        <p class="font-sentient text-sm italic leading-snug text-ink-muted">
          “{profile.quote.text}”
        </p>
        <footer class="mt-1 text-xs text-ink-muted/80">
          — <cite class="not-italic">{profile.quote.author}</cite>
        </footer>
      </blockquote>
    </div>

    <nav aria-label="หน้าหลัก">
      <ul class="flex flex-wrap gap-x-5 gap-y-2" role="list">
        {
          navItems.map((item) => (
            <li>
              <HomeNavLink
                href={item.href}
                nav={item.nav}
                label={item.label}
                active={current === item.nav}
              />
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="flex shrink-0 flex-col items-end gap-2">
    {/* <ThemeToggle /> */}
    <Image
      src={me}
      alt={`รูปโปรไฟล์ ${profile.name}`}
      class="size-16 rounded-lg object-cover"
    />
  </div>
</header>

<script>
  type NavId = "home" | "work" | "writing";

  function getCurrentNav(pathname: string): NavId | null {
    if (pathname === "/" || pathname === "") return "home";
    if (pathname.startsWith("/work")) return "work";
    if (pathname.startsWith("/writing") || pathname.startsWith("/blog"))
      return "writing";
    return null;
  }

  function updateNav() {
    const current = getCurrentNav(window.location.pathname);

    document
      .querySelectorAll<HTMLAnchorElement>("[data-nav]")
      .forEach((link) => {
        const isActive = link.dataset.nav === current;

        link.classList.toggle("home-nav-link--active", isActive);

        if (isActive) {
          link.setAttribute("aria-current", "page");
        } else {
          link.removeAttribute("aria-current");
        }
      });
  }

  updateNav();
</script>
