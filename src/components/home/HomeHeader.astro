---
import { profile } from "../../data/profile";

interface Props {
  current?: "home" | "work" | "writing";
}

const { current = "home" } = Astro.props;

const initials = profile.name
  .split(" ")
  .map((part) => part[0])
  .slice(0, 2)
  .join("");
---

<header id="top" class="scroll-mt-8" transition:persist="site-header">
  <div
    class="mb-5 flex size-11 items-center justify-center rounded-full bg-olive-200 text-sm font-medium text-ink-muted"
    role="img"
    aria-label="รูปโปรไฟล์ (placeholder)"
  >
    {initials}
  </div>

  <div class="mb-5">
    <h1 class="text-balance text-xl font-bold leading-[1.15] text-ink">
      {profile.name}
    </h1>
    <!-- <p class="mt-1 text-sm italic text-ink-muted">
      aka {profile.handle}
    </p> -->
  </div>

  <nav aria-label="หน้าหลัก">
    <ul class="flex flex-wrap gap-x-5 gap-y-2" role="list">
      <li>
        <a
          href="/"
          data-nav="home"
          class:list={[
            "home-nav-link",
            { "home-nav-link--active": current === "home" },
          ]}
          {...current === "home" ? { "aria-current": "page" } : {}}
        >
          {
            current === "home" ? (
              <>
                <span class="inline-block mr-1 size-2 rounded-full bg-ink align-middle" />
                <span class="align-middle">หน้าหลัก</span>
              </>
            ) : (
              "หน้าหลัก"
            )
          }
        </a>
      </li>
      <li>
        <a
          href="/work"
          data-nav="work"
          class:list={[
            "home-nav-link",
            { "home-nav-link--active": current === "work" },
          ]}
          {...current === "work" ? { "aria-current": "page" } : {}}
        >
          {
            current === "work" ? (
              <>
                <span class="inline-block mr-1 size-2 rounded-full bg-ink align-middle" />
                <span class="align-middle">ผลงาน</span>
              </>
            ) : (
              "ผลงาน"
            )
          }
        </a>
      </li>
      <li>
        <a
          href="/writing"
          data-nav="writing"
          class:list={[
            "home-nav-link",
            { "home-nav-link--active": current === "writing" },
          ]}
          {...current === "writing" ? { "aria-current": "page" } : {}}
        >
          {
            current === "writing" ? (
              <>
                <span class="inline-block mr-1 size-2 rounded-full bg-ink align-middle" />
                <span class="align-middle">บทความ</span>
              </>
            ) : (
              "บทความ"
            )
          }
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const navLabels = {
    home: "หน้าหลัก",
    work: "ผลงาน",
    writing: "บทความ",
  } as const;

  function getCurrentNav(pathname: string) {
    if (pathname === "/" || pathname === "") return "home";
    if (pathname.startsWith("/work")) return "work";
    if (pathname.startsWith("/writing") || pathname.startsWith("/blog"))
      return "writing";
    return null;
  }

  function updateNav() {
    const current = getCurrentNav(window.location.pathname);

    document.querySelectorAll<HTMLAnchorElement>("[data-nav]").forEach((link) => {
      const nav = link.dataset.nav as keyof typeof navLabels;
      const isActive = nav === current;
      const label = navLabels[nav];

      link.classList.toggle("home-nav-link--active", isActive);

      if (isActive) {
        link.setAttribute("aria-current", "page");
        link.innerHTML = `<span class="inline-block mr-1 size-2 rounded-full bg-ink align-middle"></span><span class="align-middle">${label}</span>`;
      } else {
        link.removeAttribute("aria-current");
        link.textContent = label;
      }
    });
  }

  updateNav();
  document.addEventListener("astro:page-load", updateNav);
</script>
