---
import { Image } from "astro:assets";
import me from "../../assets/me.jpeg";
import { profile } from "../../data/profile";
import HomeNavLink from "./HomeNavLink.astro";

interface Props {
  current?: "home" | "work" | "writing";
}

const { current = "home" } = Astro.props;

const navItems = [
  { nav: "home", href: "/", label: "หน้าหลัก" },
  { nav: "work", href: "/work", label: "ผลงาน" },
  { nav: "writing", href: "/writing", label: "บทความ" },
] as const;
---

<header
  id="top"
  class="scroll-mt-8 flex items-start justify-between gap-5"
  transition:persist="site-header"
>
  <div>
    <h1
      class="mb-5 text-balance font-sentient text-xl font-bold leading-[1.15] text-ink"
    >
      {profile.name}
    </h1>

    <nav aria-label="หน้าหลัก">
      <ul class="flex flex-wrap gap-x-5 gap-y-2" role="list">
        {
          navItems.map((item) => (
            <li>
              <HomeNavLink
                href={item.href}
                nav={item.nav}
                label={item.label}
                active={current === item.nav}
              />
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <Image
    src={me}
    alt={`รูปโปรไฟล์ ${profile.name}`}
    class="size-16 shrink-0 rounded-lg object-cover"
  />
</header>

<script>
  type NavId = "home" | "work" | "writing";

  function getCurrentNav(pathname: string): NavId | null {
    if (pathname === "/" || pathname === "") return "home";
    if (pathname.startsWith("/work")) return "work";
    if (pathname.startsWith("/writing") || pathname.startsWith("/blog"))
      return "writing";
    return null;
  }

  function updateNav() {
    const current = getCurrentNav(window.location.pathname);

    document
      .querySelectorAll<HTMLAnchorElement>("[data-nav]")
      .forEach((link) => {
        const isActive = link.dataset.nav === current;

        link.classList.toggle("home-nav-link--active", isActive);

        if (isActive) {
          link.setAttribute("aria-current", "page");
        } else {
          link.removeAttribute("aria-current");
        }
      });
  }

  document.addEventListener("astro:page-load", updateNav);
  updateNav();
</script>
