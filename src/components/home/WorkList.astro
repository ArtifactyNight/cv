---
import { profile } from "../../data/profile";
import SectionHeadline from "./SectionHeadline.astro";
---

<section class="scroll-mt-8" aria-labelledby="work-heading">
  <SectionHeadline id="work-heading">Open Source</SectionHeadline>

  <div
    class="marker:text-xs marker:font-normal marker:tabular-nums marker:text-ink-muted"
    role="list"
  >
    {
      profile.work.map((item) => (
        <a
          href={item.href}
          class="group flex flex-wrap items-baseline gap-x-1 gap-y-0.5 py-1.5"
        >
          <span class="text-sm underline-offset-2 decoration-2 font-semibold leading-snug text-ink group-hover:text-accent group-hover:underline">
            {item.name}
          </span>
          <span class="text-sm text-ink-muted" aria-hidden="true">
            /
          </span>
          <span class="text-sm text-ink-muted">{item.description}</span>
        </a>
      ))
    }
  </div>
</section>
