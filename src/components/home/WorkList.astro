---
import { profile } from "../../data/profile";
import SectionHeadline from "./SectionHeadline.astro";
---

<section class="scroll-mt-8" aria-labelledby="work-heading">
  <SectionHeadline id="work-heading">Work</SectionHeadline>

  <ul class="space-y-2" role="list">
    {
      profile.work.map((item) => (
        <li class="flex flex-wrap items-baseline gap-x-1 gap-y-0.5 py-1.5">
          <a
            href={item.href}
            class="text-sm font-semibold leading-snug text-ink no-underline hover:text-accent hover:underline"
          >
            {item.name}
          </a>
          <span class="text-sm text-ink-muted" aria-hidden="true">
            /
          </span>
          <span class="text-sm text-ink-muted">{item.description}</span>
        </li>
      ))
    }
  </ul>
</section>
