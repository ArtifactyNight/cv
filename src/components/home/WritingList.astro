---
import type { CollectionEntry } from "astro:content";
import { formatWritingDate } from "../../lib/format-date";
import SectionHeadline from "./SectionHeadline.astro";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

<section aria-labelledby="writing-heading">
  <SectionHeadline id="writing-heading">บทความ</SectionHeadline>

  {
    posts.length === 0 ? (
      <p class="text-ink-muted text-sm">ยังไม่มีบทความ</p>
    ) : (
      <ul class="space-y-2" role="list">
        {posts.map((post) => (
          <li class="flex flex-wrap items-baseline gap-x-4 gap-y-1 py-2">
            <time
              class="text-sm font-medium text-ink-muted whitespace-nowrap tabular-nums"
              datetime={post.data.pubDate.toISOString()}
            >
              {formatWritingDate(post.data.pubDate)}
            </time>
            <a
              href={`/blog/${post.id}/`}
              class="text-sm font-semibold leading-snug text-ink no-underline hover:text-accent hover:underline"
            >
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>
