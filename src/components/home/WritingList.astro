---
import type { CollectionEntry } from "astro:content";
import { formatWritingDate } from "../../lib/format-date";
import SectionHeadline from "./SectionHeadline.astro";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

<section aria-labelledby="writing-heading">
  <SectionHeadline id="writing-heading">บทความ</SectionHeadline>

  {
    posts.length === 0 ? (
      <p class="text-ink-muted text-sm">ยังไม่มีบทความ</p>
    ) : (
      <div class="space-y-2">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="flex flex-wrap items-baseline gap-x-4 gap-y-1 py-2 group"
          >
            <span class="text-sm font-medium text-ink-muted whitespace-nowrap tabular-nums">
              {formatWritingDate(post.data.pubDate)}
            </span>
            <span class="text-sm underline-offset-2 decoration-2 font-semibold leading-snug text-ink group-hover:text-accent group-hover:underline">
              {post.data.title}
            </span>
          </a>
        ))}
      </div>
    )
  }
</section>
