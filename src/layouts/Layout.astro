---
import { Image } from "astro:assets";
import adamLeft from "../assets/adam/left.png";
import adamRight from "../assets/adam/right.png";
import BaseHead from "../components/BaseHead.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../const";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  noindex,
} = Astro.props;
---

<!doctype html>
<html lang="th">
  <head>
    <BaseHead title={title} description={description} noindex={noindex} />
  </head>
  <body>
    <div
      class="adam-hands pointer-events-none fixed inset-0 z-0 hidden min-[900px]:block"
      aria-hidden="true"
    >
      <Image
        src={adamLeft}
        alt=""
        widths={[240, 360]}
        sizes="(min-width: 900px) 18rem, 0px"
        loading="lazy"
        decoding="async"
        class="adam-hand adam-hand--left"
      />
      <Image
        src={adamRight}
        alt=""
        widths={[240, 360]}
        sizes="(min-width: 900px) 18rem, 0px"
        loading="lazy"
        decoding="async"
        class="adam-hand adam-hand--right"
      />
    </div>
    <main
      class="relative z-10 mx-auto w-full max-w-2xl px-4 py-10 flex flex-col"
    >
      <div class="flex flex-col gap-12">
        <slot />
      </div>
    </main>
  </body>
</html>

<script>
  async function initPageMotion() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const [{ initAdamHands }, { initSectionTransitions }] = await Promise.all([
      import("../lib/adam-hands"),
      import("../lib/section-transition"),
    ]);

    initAdamHands();
    initSectionTransitions();
  }

  initPageMotion();
</script>
