---
import BaseHead from "../components/BaseHead.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../const";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  ogImage,
} = Astro.props;
---

<!doctype html>
<html lang="th">
  <head>
    <BaseHead title={title} description={description} ogImage={ogImage} />
  </head>
  <body>
    <main class="mx-auto w-full max-w-2xl px-4 py-10 flex flex-col">
      <div class="flex flex-col gap-12">
        <slot />
      </div>
    </main>
  </body>
</html>
