---
import type { CollectionEntry } from "astro:content";
import Breadcrumbs from "../components/blog/Breadcrumbs.astro";
import { PROSE_CLASSES } from "../const";
import type { AdjacentPosts } from "../lib/blog-nav";
import { formatWritingDate } from "../lib/format-date";
import Layout from "./Layout.astro";

type BlogData = CollectionEntry<"blog">["data"];

interface Props extends BlogData {
  slug: string;
  adjacent: AdjacentPosts;
  description: string;
}

const { title, description, pubDate, updatedDate, slug, adjacent } =
  Astro.props;
---

<Layout title={title} description={description} ogImage={`/og/${slug}.svg`}>
  <article>
    <Breadcrumbs
      crumbs={[
        { label: "หน้าแรก", href: "/" },
        { label: "บทความ", href: "/writing" },
        { label: title },
      ]}
    />

    <header class="mb-6">
      <time
        class="block text-sm font-medium text-ink-muted tabular-nums mb-4"
        datetime={pubDate.toISOString()}
      >
        {formatWritingDate(pubDate)}
      </time>

      <h1 class="text-balance text-xl font-bold leading-[1.15] text-ink">
        {title}
      </h1>

      {
        updatedDate && (
          <p class="mt-3 text-sm text-ink-muted">
            อัปเดตล่าสุด{" "}
            <time datetime={updatedDate.toISOString()}>
              {formatWritingDate(updatedDate)}
            </time>
          </p>
        )
      }
    </header>

    <div class={PROSE_CLASSES}>
      <slot />
    </div>

    <!-- <ReadFooter newer={adjacent.newer} older={adjacent.older} /> -->
  </article>
</Layout>
